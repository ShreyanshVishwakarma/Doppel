{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "mcp": {
    "solari": {
      "type": "local",
      "command": ["npx", "-y", "@solarisdk/mcp"],
      "enabled": true,
      "environment": {
        "SOLARI_API_KEY": "${SOLARI_API_KEY}"
      }
    }
  },
  "mcpServers": {
    "solari": {
      "command": "npx",
      "args": ["-y", "@solarisdk/mcp"],
      "env": {
        "SOLARI_API_KEY": "${SOLARI_API_KEY}"
      }
    }
  }
}
