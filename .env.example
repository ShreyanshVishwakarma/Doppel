# Next.js / Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Public Convex deployment URL used by the browser client and chat route
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_APP_URL=http://localhost:3000  # public URL — used for Open Graph metadata

# Set the same issuer domain in Convex Dashboard > Settings > Environment Variables.
# It must match the Clerk instance that issues the `convex` JWT template.
CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev

# Vercel AI Gateway (or configure the provider according to the AI SDK docs)
AI_GATEWAY_API_KEY=

# Server-only Solari key. Never expose this as NEXT_PUBLIC_* — single key for browser+sandbox+desktop
SOLARI_API_KEY=slr_live_...

# Sandbox harness — fork per prompt from this snapshot (built via scripts/build-harness-snapshot.mjs)
SANDBOX_SNAPSHOT_ID=snap_xxx_opencode-harness-v1
# Optional: secret for harness->Convex callbacks (if using updateBySandboxId)
SANDBOX_HARNESS_SECRET=replace-with-long-random-secret
